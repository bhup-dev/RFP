# Copy to .env and adjust locally. No API keys are required to start the API.
APP_NAME=RFP Intelligence Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api
LOG_LEVEL=INFO
# auto uses json when ENVIRONMENT=production and text otherwise. text and json are also valid.
LOG_FORMAT=auto
REQUEST_TIMEOUT_SECONDS=60
HEALTH_CHECK_TIMEOUT_SECONDS=2
# Created on startup. Relative paths are resolved from the backend directory.
STORAGE_PATH=storage
# Folder of bid directories to scan. Relative paths are resolved from the backend directory.
# The directory is not created automatically and is not parsed by the scan.
INGESTION_INPUT_ROOT=data/bids
# Character counts for narrative chunks. Overlap must be smaller than CHUNK_SIZE.
# Table groups are bounded by row count so a row is not cut off mid-cell.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TABLE_CHUNK_MAX_ROWS=20
CHUNK_MIN_TEXT_LENGTH=50

# Example only. Replace the user, password, host, and database name locally.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rfp_intelligence

# Local Qdrant. Leave the API key empty unless the server requires one.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rfp_document_chunks

# LLM completions. openai is the supported provider. Leave the key blank to start the API.
# A completion request fails with a configuration error until OPENAI_API_KEY is set.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.5
OPENAI_API_KEY=

# Embeddings. The model and dimension are independent of LLM_MODEL.
# text-embedding-3-small uses 1536 dimensions. EMBEDDING_DIMENSION must match the
# existing Qdrant collection. This application does not resize a collection.
# To use another size, set EMBEDDING_DIMENSION and create a new QDRANT_COLLECTION_NAME.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# Chunks embedded and upserted together. Also the PostgreSQL page size.
EMBEDDING_BATCH_SIZE=32

# Hybrid retrieval. RRF ranks begin at 1. When degraded fallback is enabled,
# one healthy backend may return results with an explicit non-hybrid mode.
SEARCH_RRF_CONSTANT=60
SEARCH_ALLOW_DEGRADED=true

# Query rewriting uses the configured LLM lazily. The original query is always searched.
QUERY_REWRITING_ENABLED=true
QUERY_REWRITE_MAX_VARIANTS=3
QUERY_REWRITE_TIMEOUT_SECONDS=10

# Local cross-encoder reranking is optional and disabled by default.
# Install sentence-transformers separately before enabling it.
RERANKING_ENABLED=false
RERANKER_PROVIDER=sentence_transformers
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATE_LIMIT=30
RERANK_BATCH_SIZE=8
RERANK_TIMEOUT_SECONDS=15
# Long model inputs keep both the beginning and end; returned chunk text is unchanged.
RERANK_MAX_INPUT_CHARACTERS=8000

# Structured extraction. Evidence is collected with multiple field-group searches.
EXTRACTION_QUERY_TOP_K=12
EXTRACTION_MAX_EVIDENCE_CHUNKS=60
EXTRACTION_MAX_OUTPUT_TOKENS=8000

# Addendum analysis runs one bounded comparison per explicit amendment document.
ADDENDUM_MAX_CHUNKS_PER_DOCUMENT=30
ADDENDUM_RELATED_TOP_K=8
ADDENDUM_MAX_EVIDENCE_CHUNKS=60
ADDENDUM_MAX_OUTPUT_TOKENS=8000

# Evidence-based extraction validation. Scores are heuristics, not calibrated probabilities.
VALIDATION_SEMANTIC_ENABLED=true
VALIDATION_HIGH_CONFIDENCE_THRESHOLD=0.80
VALIDATION_MEDIUM_CONFIDENCE_THRESHOLD=0.55
VALIDATION_MAX_OUTPUT_TOKENS=2000

# LangGraph orchestration. memory checkpoints do not survive process restarts.
# PostgreSQL workflow records remain the durable source of business status.
LANGGRAPH_CHECKPOINTING_ENABLED=true
LANGGRAPH_CHECKPOINTER_BACKEND=memory
LANGGRAPH_WORKFLOW_VERSION=1.0
LANGGRAPH_WORKFLOW_TIMEOUT_SECONDS=300

# Specialized RFP agents reuse LLM_MODEL and the existing retrieval providers.
SPECIALIZED_AGENTS_ENABLED=true
SPECIALIZED_AGENT_TIMEOUT_SECONDS=45
SPECIALIZED_AGENT_MAX_EVIDENCE_CHUNKS=12
SPECIALIZED_AGENT_MAX_OUTPUT_TOKENS=6000

# Comparison requests create history records and never trigger extraction.
BID_COMPARISON_MAX_BIDS=5
BID_COMPARISON_SEMANTIC_TIMEOUT_SECONDS=30
BID_COMPARISON_MAX_SEMANTIC_ROWS=20
BID_COMPARISON_MAX_OUTPUT_TOKENS=4000

# Gates apply only to independently labeled deterministic invariants.
EVALUATION_EXACT_IDENTIFIER_MIN=1.0
EVALUATION_INVALID_CITATION_REJECTION_MIN=1.0
EVALUATION_CONFLICT_RECALL_MIN=1.0

# Review APIs are disabled until a shared bearer token is configured.
# Reviewer IDs are asserted by token holders; no full identity/RBAC system exists.
HUMAN_REVIEW_ENABLED=true
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.55
HUMAN_REVIEW_CRITICAL_FIELDS=Due Date,Term of Bid,Contract or Cooperative to use
HUMAN_REVIEW_MAX_REEVALUATION_ATTEMPTS=2
HUMAN_REVIEW_API_TOKEN=

# Bid Q&A (POST /api/v1/bids/{bid_id}/ask). Each question costs one query embedding
# and one LLM call. Answers are built from the QA_TOP_K retrieved passages per bid plus
# read-only stored records (profile fields, addendum findings, open review items).
QA_TOP_K=10
QA_MAX_HISTORY_TURNS=6
QA_MAX_OUTPUT_TOKENS=1200
QA_MAX_PASSAGE_CHARACTERS=1500
# Extra bids a user may add to one chat for comparison questions.
QA_MAX_COMPARE_BIDS=1
QA_MAX_ADDENDUM_RECORDS=15
QA_MAX_REVIEW_RECORDS=15

# Browser uploads. Files are written under INGESTION_INPUT_ROOT/<bid_identifier>/.
# Only extensions with a parser (pdf, html, htm) are accepted; content is sniffed too.
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_FILES_PER_REQUEST=20
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.html,.htm

# Background processing. Jobs are stored in PostgreSQL and survive restarts.
# JOB_WORKER_EMBEDDED=true runs the worker inside the API process. Keep it true while
# LANGGRAPH_CHECKPOINTER_BACKEND=memory: human-review decisions resume workflows from
# the API process's checkpoints. Set it false only to run `python -m app.worker` instead.
# Jobs whose heartbeat is older than JOB_STALE_AFTER_SECONDS are requeued or failed.
JOB_WORKER_EMBEDDED=true
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=3
JOB_STALE_AFTER_SECONDS=900
JOB_HEARTBEAT_INTERVAL_SECONDS=30

# Comma-separated browser origins allowed to call the API directly.
# Leave empty when the frontend is served through a same-origin proxy.
CORS_ALLOWED_ORIGINS=
